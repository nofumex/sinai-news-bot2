[Unit]
Description=Sinai Telegram and MAX polling bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sinai
Group=sinai
WorkingDirectory=/opt/sinai-crm-bot
EnvironmentFile=/opt/sinai-crm-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sinai-crm-bot/.venv/bin/python -m sinai
Restart=always
RestartSec=15
TimeoutStopSec=150
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sinai-crm-bot/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

